export function SettingsPage() {
  const [categoryId, setCategoryId] = useState(CATEGORIES[0].id);
  const category = CATEGORIES.find((c) => c.id === categoryId)!;
  const [panelId, setPanelId] = useState(category.panels[0].id);

  const activeCategory = CATEGORIES.find((c) => c.id === categoryId)!;
  const activePanel = activeCategory.panels.find((p) => p.id === panelId) ?? activeCategory.panels[0];
  const ActiveComponent = activePanel.Component;

  function selectCategory(id: string) {
    setCategoryId(id);
    const next = CATEGORIES.find((c) => c.id === id)!;
    setPanelId(next.panels[0].id);
  }

  return (
    <div className="flex h-full">
      {/* Category / sub-item sidebar */}
      <aside className="w-64 shrink-0 overflow-y-auto border-r border-gray-200 bg-white py-4">
        {CATEGORIES.map((cat) => (
          <div key={cat.id} className="mb-1">
            <button
              onClick={() => selectCategory(cat.id)}
              className={`flex w-full items-center px-4 py-2 text-left text-sm font-semibold ${
                cat.id === categoryId ? 'text-blue-700' : 'text-gray-800 hover:bg-gray-50'
              }`}
            >
              {cat.label}
            </button>
            {cat.id === categoryId && (
              <div className="mt-1 space-y-0.5 pb-1">
                {cat.panels.map((p) => (
                  <button
                    key={p.id}
                    onClick={() => setPanelId(p.id)}
                    className={`block w-full px-8 py-1.5 text-left text-sm ${
                      p.id === panelId
                        ? 'bg-blue-50 font-medium text-blue-700'
                        : 'text-gray-600 hover:bg-gray-50'
                    }`}
                  >
                    {p.title}
                  </button>
                ))}
              </div>
            )}
          </div>
        ))}
      </aside>

      {/* Content */}
      <main className="flex-1 overflow-y-auto bg-gray-50 p-6">
