        <div className="mb-4 text-sm text-gray-400">{category.panels.length} settings in this group</div>

        {/* quick-switch cards */}
        <div className="mb-6 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {category.panels.map((p) => (
            <button
              key={p.id}
              onClick={() => setPanelId(p.id)}
              className={`rounded-lg border px-4 py-3 text-left ${
                p.id === panelId ? 'border-blue-500 bg-blue-50/50' : 'border-gray-200 bg-white hover:border-gray-300'
              }`}
            >
              <p className="text-sm font-semibold text-gray-900">{p.title}</p>
              <p className="mt-0.5 text-xs text-gray-500">{p.description}</p>
            </button>
          ))}
        </div>

        <ActiveComponent key={activePanel.id} />
      </main>
    </div>
  );
}
